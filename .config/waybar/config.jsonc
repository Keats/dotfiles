{
    "margin-top": 0,
    "margin-left": 120,
    "margin-bottom": 0,
    "margin-right": 120,
    "layer": "top",
    "position": "top",
    "spacing": 15,
    "reload_style_on_change": true,
    "modules-left": [
        "niri/workspaces",
    ],
    "modules-center": [
    ],
    "modules-right": [
        "tray",
        "cpu",
        "memory",
        "wireplumber",
        "clock",
        "group/group-power"
    ],
    "niri/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "tooltip": false
    },
    "tray": {
        "icon-size": 20,
        "spacing": 10,
        "tooltip": false
    },
    "clock": {
        "format": " {:%H:%M}",
        "tooltip-format": "<big><tt>{calendar}</tt></big>",
        "locale": "fr_FR.UTF-8",
        "calendar": {
            "mode": "month",
            "format": {
                "months": "<span color='#d79921'><b>{}</b></span>",
                "days": "<span color='#ebdbb2'>{}</span>",
                "weekdays": "<span color='#458588'><b>{}</b></span>",
                "today": "<span color='#cc241d'><u><b>{}</b></u></span>"
            },
        },
    },
    "cpu": {
        "format": " {usage}%",
        "tooltip": false,
    },
    "memory": {
        "format": " {}%",
        "tooltip": true,
        "tooltip-format": "Memory Usage: {used:0.1f}GB/{total:0.1f}GB"
    },
    "wireplumber": {
        "scroll-step": 1,
        "max-volume": 100,
        "format": "{icon}  {volume}%",
        "format-bluetooth": "{icon} {volume}%",
        "format-muted": "",
        "format-icons": {
            "headphones": "",
            "handsfree": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": [
                "",
                ""
            ]
        },
        "nospacing": 1,
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "tooltip": false
    },
    "custom/poweroff": {
        "format": "",
        "on-click": "systemctl poweroff",
        "tooltip": false
    },
    "custom/reboot": {
        "format": "",
        "tooltip": false,
        "on-click": "systemctl reboot",
    },
    "custom/lock": {
        "format": "",
        "tooltip": false
    },
    "group/group-power": {
        "drawer": {
            "children-class": "not-poweroff",
            "transition-duration": 500,
            "transition-left-to-right": false,
        },
        "modules": [
            "custom/poweroff",
            "custom/reboot",
            "custom/lock"
        ],
        "orientation": "inherit",
    }
}